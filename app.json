{
  "expo": {
    "name": "Poker Hands Coach",
    "slug": "pokergpt",
    "owner": "leandertoney",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/pokergpt_logo.png",
    "scheme": "pokergpt",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/pokergpt_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6A0B0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pokergpt.app",
      "buildNumber": "4",
      "icon": "./assets/images/pokergpt_logo.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Poker Hands Coach uses the microphone for hands-free voice conversations with your AI poker coach. Speak naturally to discuss hands and get instant strategy advice.",
        "NSCameraUsageDescription": "Poker Hands Coach does not use the camera. This permission is declared by frameworks the app depends on and is never requested.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Poker Hands Coach lets you choose a photo from your library to use as your profile picture. Photos stay on your device and are never uploaded."
      }
    },
    "android": {
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pokergpt_logo.png",
        "backgroundColor": "#6A0B0B"
      },
      "package": "com.pokergpt.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Poker Hands Coach uses the microphone for hands-free voice conversations with your AI poker coach."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#6A0B0B"
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-updates",
        {
          "username": "leandertoney"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile picture. Photos stay on your device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74438842-5df3-4dd3-96e1-35306d266aa5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/74438842-5df3-4dd3-96e1-35306d266aa5"
    }
  }
}