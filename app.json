{
  "expo": {
    "name": "PokerGPT",
    "slug": "pokergpt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pokergpt_logo.png",
    "scheme": "pokergpt",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/pokergpt_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokergpt.app",
      "icon": "./assets/images/pokergpt_logo.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pokergpt_logo.png",
        "backgroundColor": "#1A0505"
      },
      "package": "com.pokergpt.app",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
