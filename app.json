{
  "expo": {
    "name": "PokerGPT",
    "slug": "pokergpt",
    "owner": "leandertoney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pokergpt_logo.png",
    "scheme": "pokergpt",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/pokergpt_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6A0B0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokergpt.app",
      "buildNumber": "2",
      "icon": "./assets/images/pokergpt_logo.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pokergpt_logo.png",
        "backgroundColor": "#6A0B0B"
      },
      "package": "com.pokergpt.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74438842-5df3-4dd3-96e1-35306d266aa5"
      }
    }
  }
}
