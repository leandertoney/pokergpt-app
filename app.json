{
  "expo": {
    "name": "PokerGPT",
    "slug": "pokergpt",
    "owner": "leandertoney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pokergpt_logo.png",
    "scheme": "pokergpt",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/pokergpt_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6A0B0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokergpt.app",
      "buildNumber": "9",
      "icon": "./assets/images/pokergpt_logo.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "PokerGPT uses the microphone for hands-free voice conversations with your AI poker coach. Speak naturally to discuss hands and get instant strategy advice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pokergpt_logo.png",
        "backgroundColor": "#6A0B0B"
      },
      "package": "com.pokergpt.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "PokerGPT uses the microphone for hands-free voice conversations with your AI poker coach."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#6A0B0B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74438842-5df3-4dd3-96e1-35306d266aa5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/74438842-5df3-4dd3-96e1-35306d266aa5"
    }
  }
}
